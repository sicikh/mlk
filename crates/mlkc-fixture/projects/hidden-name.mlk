// The paths a body writes, and what walking them finds: a name another module keeps to itself,
// a data type written where a value belongs, and a module that is not there. The paths of a body
// are walked by the check and never by the resolution, so what they find is the check's to
// report.

//- /types.mlk
// The module `project::types`: it keeps the function `hidden` to itself, and shows a data type.

pub data Point

fun hidden(): Int =
    1

//- /main.mlk
use project::types::Point

fun call(): Int =
    project::types::hidden()

fun make(): Point =
    project::types::Point

fun gone(): Int =
    project::gone::x()
