// What a module takes from the rest of the project: the names of a tree, the names one path
// brings in, and a path rooted at the project.

//- /types.mlk
// The module `project::types`: it declares a data type of its own, and modules stand under its
// name.

pub data Point

pub fun origin(): Point =
    origin()

//- /types/utils.mlk
// The module `project::types::utils`, which is one of the modules the prefix `project::types`
// stands on.

pub data Point

pub fun make(): Point =
    make()

//- /main.mlk
// The two names are taken by one tree: `self` is the module `project::types` itself, and the
// name after it is read inside that module.

use project::{types::{self, utils::Point as Other}}

fun handle(value: types::Point, other: Other): Int =
    1

fun read(value: project::types::utils::Point): Int =
    1
