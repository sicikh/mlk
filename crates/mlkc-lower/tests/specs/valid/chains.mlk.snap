## Input

```mlk
// The split of the dot: a call with the value passed as its first argument, a field read, and
// a path. What a chain is a chain of is known from the text alone.

#[builtin]
type Int

#[builtin]
type Config

#[builtin]
type Persons

#[builtin]
type Name

#[builtin]
type Data

#[builtin]
type Map

fun load(config: Config): Config =
    config

fun validate(config: Config): Config =
    config

fun start(config: Config): Int =
    config

fun chained(config: Config): Int =
    config.load().validate().start()

fun insert(persons: Persons, name: Name, data: Data): Persons =
    persons

// The callee of a step may be a path: the path says which `insert` the step means, and the
// receiver is passed as the first argument.
fun add(persons: Persons, name: Name, data: Data): Persons =
    persons.Map::insert(name, data)

// A field read: the name is what the type of the value is read for, and the value may be the
// result of a call.
fun port(config: Config): Int =
    config@server@port

fun loaded_port(config: Config): Int =
    config.load()@port

```

