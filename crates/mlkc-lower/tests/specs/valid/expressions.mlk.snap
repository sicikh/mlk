## Input

```mlk
// Where every operator sits in the precedence table, and what calls and parentheses do to
// it; a sign in front of an expression reads the same way, and a path names a value the way
// it names a type.

@builtin
type Int

fun products(): Int =
    42 * 2 - 10

fun comparisons(): Int =
    1 + 2 * 3 <= 4 * 5 / 6

fun logic(): Int =
    1 == 2 || 3 < 4 && 5 >= 6

fun parentheses(): Int =
    (1 + 2) * (3 - 4)

fun calls(): Int =
    f(g(1), h(2, 3))

fun signs(): Int =
    -1 + +2 - -3

fun negated_call(): Int =
    -f(1)

fun path_to_a_value(): Int =
    data.main-module.start-app(1)

fun qualified_call(): Int =
    std.core.size(1)

```

