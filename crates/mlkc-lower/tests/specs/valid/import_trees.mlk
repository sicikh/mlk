// An import tree: the names a module takes from one path, each of them with the name it is
// brought in under. A group reads its names inside the path before it, and the keyword `self`
// takes the path itself.

module project::app

use std::{core::{Int as Integer, Bool}, prelude::{self, String}}

use project::types::{self, utils::Point}

pub use project::types::Map as Map-of-types

fun main(size: Integer, flag: Bool): Integer =
    size

fun handle(value: types::Point, point: Point, map: Map-of-types): String =
    text

fun text(): String =
    ""
