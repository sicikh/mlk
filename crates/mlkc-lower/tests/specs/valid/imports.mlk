// What a module takes from the rest of the project: a name, a name it is renamed to, a name it
// is brought in under, and the path of a module, which is what the names after a path of it
// are resolved against.

module my-proj.app

use std.core.Int

pub use std.core.io as IO

use my-proj.data

use my-proj.data.start-app

fun main(): IO =
    start-app(1)

fun handle(value: data.Handle): Int =
    value

// A path that starts at a name of the module: what follows the first name is read inside
// what it denotes, and the module of the import is what the names after it are resolved
// against.
fun start(): Int =
    data.main-module.start-app()
