// Bindings: nested, ignored, and bound to the result of a call.

#[builtin]
type Int

#[extern]
fun f(value: Int): Int

#[extern]
fun g(left: Int, right: Int): Int

fun nested(): Int =
    let x = 1 in
    let y = 2 in
    x + y

fun ignored(): Int =
    let _ = 1 in
    2

fun bound_to_a_call(): Int =
    let x = f(1) in
    g(x, x)

fun shadows_a_parameter(x: Int): Int =
    let x = x + 1 in
    x
