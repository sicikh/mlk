## Input

```mlk
// A `local` is lowered into the HIR as the expression after the `in` and the entities its items
// declare: each item is a function of the enclosing body, with the name it is declared under, its
// signature, the patterns of its parameters, and its root expression. The expressions of an item
// live in the arenas of the body that wrote it.
//
// A function declared inside a body is given its own parameters only: what the body that declares
// it binds is not part of it, and what it reads of the module it reaches without an environment.

#[builtin]
type Int

#[builtin]
type Bool

#[extern]
fun consume(left: Int, right: Int): Int

// A function declared in a `local` is called by the name it declares, and the path of the call is
// anchored to the entity of the body.
fun direct(value: Int): Int =
    local fun double(x: Int): Int = x * 2 in
    double(value)

// The names of the items are visible in the items themselves: an item may call itself and the
// ones written next to it.
fun mutual(value: Int): Int =
    local
        fun step(x: Int): Int = if x == 0 then 0 else step(x - 1)
        fun twice(x: Int): Int = step(x) + step(x)
    in
        twice(value)

// What an item binds itself is its own: a `let` written inside it is read by its body the way
// a `let` is read anywhere else.
fun bound(value: Int): Int =
    local fun add(x: Int): Int = let next = x + 1 in next + x in
    add(value)

// A name a `local` declares is a name of the body: it shadows a parameter the body was entered
// with, and the paths of the `local` read the item.
fun renamed(value: Int): Int =
    local fun value(): Int = 1 in
    value() + 2

// A `let` written inside a `local` shadows the name of an item, and the name is the binding from
// there on.
fun shadowed(value: Int): Int =
    local fun double(x: Int): Int = x * 2 in
    let double = value in
    double + 1

// A parameter the item ignores is a wildcard, as the parameter of a module function is, and the
// signature of the item is resolved against the types of the module.
fun ignored(value: Bool): Int =
    local fun nothing(_: Bool): Int = 0 in
    nothing(value)

// A `local` inside a `local`: the body of an item is an expression of the enclosing body, and the
// items of the inner one are entities of the same body.
fun nested(value: Int): Int =
    local fun outer(x: Int): Int =
        local fun inner(y: Int): Int = y + 1 in
        inner(x)
    in
        outer(value)

// The pipeline is an expression of the body wherever it is written: the body of an item is an
// expression like any other, and the binding a pipeline makes is the item's own.
fun piped(value: Int): Int =
    local fun pass(x: Int): Int = x |> consume(_, 1) in
    if value == 0 then 0 else pass(value)

```

