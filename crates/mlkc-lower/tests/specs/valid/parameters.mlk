// A parameter is a pattern: a name the body binds and reads, and a wildcard it ignores. What
// a signature says of a parameter is its type --- the pattern is the body's, and the two line
// up by position --- and a parameter may leave its type to be inferred where the function is
// not public.

@builtin
type Int

fun used(value: Int): Int =
    value

fun ignored(_: Int): Int =
    1

fun mixed(value: Int, _: Int): Int =
    value

fun inferred(value, _) =
    value
