// --- stdlib.mlk

#[builtin]
type Unit

#[builtin]
type Int

// --- main.mlk ---

#[extern]
fun println-int(value : Int): Unit

fun main(): Unit =
    let x = 42 * 2 - 10 in
    println-int(x + 20)

