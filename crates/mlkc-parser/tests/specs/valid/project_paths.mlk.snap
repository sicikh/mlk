## Input

```mlk
// A path rooted at the project: the keyword a module names the project it is written in by,
// which no manifest can rename out from under it.

module project::app

use project::types

use project::core::Int

fun start(): Int =
    project::types::start-app(1)

fun handle(value: project::types::Handle): Unit =
    value

