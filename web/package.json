{
    "name": "@mlk/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "predev": "pnpm --filter @mlk/wasm build",
        "dev": "vite dev",
        "prebuild": "pnpm --filter @mlk/wasm build",
        "build": "vite build",
        "build:grammar": "lezer-generator --noTerms --typeScript src/lib/grammar/mlk.grammar -o src/lib/grammar/mlk.ts",
        "preview": "vite preview",
        "check": "oxlint --deny-warnings scripts src vite.config.ts vitest.config.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "check:browser": "pnpm build && node scripts/browser-check.mjs"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.12.4",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.5",
        "@codemirror/view": "^6.43.12",
        "@lezer/highlight": "^1.2.3",
        "@lezer/lr": "^1.4.10",
        "@mlk/wasm": "workspace:*"
    },
    "devDependencies": {
        "@lezer/generator": "^1.8.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^26.6.4",
        "oxlint": "^1.86.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.3"
    }
}
