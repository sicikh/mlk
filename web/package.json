{
    "name": "@mlk/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm --filter @mlk/wasm build",
        "dev": "vite dev",
        "prebuild": "pnpm --filter @mlk/wasm build",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:browser": "pnpm build && node scripts/browser-check.mjs"
