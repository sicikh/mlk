// The grammar of MLK, for the editor.
//
// This is not the parser of the compiler: it is the one the client paints code with,
// the way an editor knows the syntax of a language on its own and asks a language server
// only for what it cannot see — the names that are resolved, the types, the meanings.
// The compiler stays the one that says what the language is (its grammar is
// `xtask/codegen/mlk.ungram`); this file follows it, and is allowed to be behind it.
//
// It is also allowed to be wrong in a way the compiler is not: a tree from here
// only decides colours, so a construct this file does not know is not an error,
// it is text with the colour of text.
//
// `mlk.ts` next to this file is generated from it, and is what the editor loads:
//
//     pnpm --filter @mlk/web build:grammar

@top ModuleRoot { item* }

// Operators, from the tightest to the loosest, which is the order the generator reads:
// a call binds tighter than `*`, `*` tighter than `+`, `+` tighter than a comparison,
// and so on (the compiler climbs the same ladder in `parse_binary_expr`). The order is
// worth a word because it is not the one the rest of this file is written in: read the
// other way round, this list parses `1 + 2 * 3` as `(1 + 2) * 3`.
@precedence {
	call @left,
	product @left,
	sum @left,
	comparison @left,
	equality @left,
	and @left,
	or @left,
	pipe @left,

	// The tail of an `if`: the arms and the `else` bind to the innermost `if` that can hold
	// them, which is what the parser of the compiler reads. The marker is what says so to the
	// generated parser: an `if` may leave its `else` unwritten, and `if a then if b then c elif …`
	// is ambiguous without one.
	if_tail @left
}

@skip { space | Comment }

item { Attribute* (ModulePreamble | FunDecl | TypeDecl | UseDecl) }

// The keywords are not tokens of their own.
//
// The lexer of the compiler matches the longest text, and a keyword only wins where
// a keyword and a name are the same length: `let` is the keyword while `letter` and
// `let-x` are names. A token per keyword cannot say that — a word like `let` would win
// over `letter` — so a keyword is a *name* here, read as a keyword in the places the
// grammar says a keyword goes: the same thing the compiler's lexer does with its
// priority, one level up.
kw<term> { @specialize[@name={term}]<identifier, term> }

ModulePreamble { kw<"module"> Path }

// An attribute of a declaration: `#[extern]`. The brackets are what a list of types is
// written with as well, and the two are told apart by the `#` and by the place.
Attribute { "#" "[" Name "]" }

// How far a declaration is visible, which the language writes in front of it, after the
// attributes it carries.
Visibility { kw<"pub"> }

FunDecl { Visibility? kw<"fun"> Name Parameters ReturnType? FunBody? }

Parameters { "(" (Parameter ("," Parameter)*)? ")" }

Parameter { Pat TypeAnnotation? }

TypeAnnotation { ":" Type }

ReturnType { ":" Type }

FunBody { "=" Expr }

TypeDecl { Visibility? kw<"type"> Name }

// An import: a path of the project, under the name it is brought in as, which is the last
// segment of the path or what it is renamed to.
UseDecl { Visibility? kw<"use"> Path UseAlias? }

UseAlias { kw<"as"> Name }

Name { identifier }

Type { Path | InferType }

Path { PathSegment ("::" PathSegment)* }

// A segment of a path: a name, or the project the module is written in, which is what a path
// is rooted at. Only the first segment of a path may be the keyword: the segments after it
// are names inside what the root denotes.
PathSegment { (Name | Project) TypeArgs? }

Project { kw<"project"> }

TypeArgs { "[" (Type ("," Type)* ","?)? "]" }

InferType { kw<"_"> }

Expr { BinaryExpr | UnaryExpr | PostfixExpr }

// A call applies to what can be called, which is what keeps `let x = 1 in f(x)`
// from being ambiguous: the decision whether `(` continues the call is taken here,
// inside one expression, and not across the whole of it.
//
// The three forms of what a value may be followed by: a call, a call with the value passed
// as its first argument, and a field read. Each is postfix, and they chain left to right.
//
// The pipeline is what a value may be followed by as well, and what is written after it is
// written after the value it is: a dot after a step calls the callee on what the step
// produced, which is what reading the pipeline as one of the forms says.
PostfixExpr { PrimaryExpr | CallExpr | UfcsCall | FieldExpr | PipeExpr }

CallExpr { PostfixExpr !call "(" (Expr ("," Expr)* ","?)? ")" }

// A call with the value written before the callee: `value.function(args)` is
// `function(value, args)`. What stands after the dot is a name or a path.
UfcsCall { PostfixExpr !call "." Path "(" (Expr ("," Expr)* ","?)? ")" }

// A field read: the value, and the name of the field.
FieldExpr { PostfixExpr !call "@" Name }

// A sign in front of an expression, which binds tighter than any binary operator:
// `-1 + 2` is `(-1) + 2`, and `-f(x)` is the negation of the call.
UnaryExpr { !call ("-" | "+") Expr }

// A lambda: a function written where a value belongs. `fn` opens it, the parameter list holds
// the patterns the body binds and the types they are written with, and the body is what stands
// after the `->`; the body extends as far as it can, so what stands after it is written after
// the value the lambda is.
LambdaExpr { kw<"fn"> LambdaParameters "->" Expr }

LambdaParameters { "(" (Parameter ("," Parameter)*)? ")" }

// A `local`: the items of a module written where a value belongs, and the expression their names
// are visible in. The list ends at the `in`, which is what the expression after it starts from.
LocalExpr { kw<"local"> ModuleItem* kw<"in"> Expr }

// An item of a module, as a `local` writes one: a declaration, with the attributes it carries in
// front of it.
ModuleItem { Attribute* (FunDecl | TypeDecl | UseDecl) }

PrimaryExpr { IfExpr | LetExpr | LambdaExpr | LocalExpr | Placeholder | Literal | PathExpr | ParenExpr }

// A place for the value a pipeline passes: `x |> f(_)`. A place is a leaf of the expression
// grammar, and the parser of the compiler reads one only among the arguments of the call on
// the right of a `|>`.
Placeholder { kw<"_"> }

LetExpr { kw<"let"> Pat "=" Expr kw<"in"> Expr }

// A choice between expressions: a condition, the expression it selects, the arms written
// after it, and the expression selected when no condition holds. Every part is an
// expression, and the keywords of the rule are what ends one of them. The `else` may be left
// unwritten, and an `if` without one selects no value.
//
// The arms and the `else` are read by the innermost `if` they can be written after: in
// `if a then if b then c elif d then e else f`, all the keywords after the second `then`
// belong to the second `if`, which is what the compiler reads as well.
IfExpr { kw<"if"> Expr kw<"then"> Expr IfArm* ElseBranch? }

IfArm { !if_tail kw<"elif"> Expr kw<"then"> Expr }

ElseBranch { !if_tail kw<"else"> Expr }

Pat { IdentPat | WildcardPat }

IdentPat { Name }

WildcardPat { kw<"_"> }

BinaryExpr {
	Expr !product ("*" | "/") Expr |
	Expr !sum ("+" | "-") Expr |
	Expr !comparison ("<=" | ">=" | "<" | ">") Expr |
	Expr !equality ("==" | "!=") Expr |
	Expr !and "&&" Expr |
	Expr !or "||" Expr
}

ParenExpr { "(" Expr ")" }

// A pipeline: a value, and the call the value goes into, with a place among the arguments of
// that call for it. The operator is the loosest one an expression has, and a step is one call
// that ends with its argument list.
PipeExpr { Expr !pipe "|>" Step }

// What stands on the right of a `|>`: a call, whose callee is a path or a call written with
// the dot, and among whose arguments a place is written.
Step { PathExpr ("." Path)? "(" (Expr ("," Expr)* ","?)? ")" }

Literal { IntLiteral | StringLiteral | BoolLiteral }

IntLiteral { int_literal }

StringLiteral { string_literal }

// A truth value: `true` or `false`. Both are keywords of the language, read where a value
// belongs.
BoolLiteral { kw<"true"> | kw<"false"> }

// A path written where a value belongs: a name, or a name of the project with the names
// inside it after it. A path is what says that a dot is never a way to name something: the
// dot is what a call with the value passed first is written with.
PathExpr { Path }

@tokens {
	// Two tokens that can match the same text are resolved by this order, and the order
	// outranks the length of the match: the earlier name wins even where the later one
	// would have matched more. That is why no keyword is declared as a token here —
	// written this way, `let` would eat the first three letters of `letter` — and this
	// pair is safe to write down because a comment is never the shorter of the two:
	// `//` opens a comment while `/` divides.
	@precedence { Comment, "/" }

	// The trivia the parser of the compiler skips as well: a line break is not part
	// of the syntax of MLK, an expression ends where its last token ends.
	space { $[ \t\r\n]+ }

	Comment { "//" ![\n\r]* | "/*" (![*] | "*" ![/])* "*/" }

	// A name may hold `-` between its parts, so `println-int` is one name while
	// `x - 1` is a subtraction. The narrowest way to write this down is what makes
	// `x-1` a name as well, and that is what the lexer of the compiler does.
	identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* ("-" $[a-zA-Z0-9_]+)* }

	int_literal { $[0-9]+ }

	// Strings hold escapes: what a backslash escapes is part of the literal, so the literal
	// ends at the quote that is not escaped. There is no interpolation: a string is its text.
	string_literal { '"' ("\\" ![\n\r] | !["\\\n\r])* '"' }
}
