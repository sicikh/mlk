// MLK Un-Grammar.
//
// This grammar specifies the structure of MLK's concrete syntax tree.
// It does not specify parsing rules (ambiguities, precedence, etc are out of scope).
// Tokens are processed -- contextual keywords are recognised, compound operators glued.
//
// Legend:
//
//   //          				-- comment
//   Name =      				-- non-terminal definition
//   'ident'     				-- token (terminal)
//   A B         				-- sequence
//   A | B       				-- alternation
//   A*          				-- zero or more repetition
//   (A (',' A)* ','?)	        -- repetition of node A separated by ',' and allowing a trailing comma
//   (A (',' A)*)	            -- repetition of node A separated by ',' without a trailing comma
//   A?          				-- zero or one repetition
//   (A)         				-- same as A
//   label:A     				-- suggested name for field of AST node

// NOTES
//
// - SyntaxNode, SyntaxToken and SyntaxElement will be stripped from the codegen
// - Bogus nodes are special nodes used to keep track of broken code; they are
//   not part of the grammar but they will appear inside the green tree


///////////////
// Bogus NODES
///////////////
// SyntaxElement is a generic data structure that is meant to track nodes and tokens
// in cases where we care about both types
//
// As Bogus* node will need to yield both tokens and nodes without discrimination,
// and their children will need to yield nodes and tokens as well.
// For this reason, SyntaxElement = SyntaxElement
SyntaxElement = SyntaxElement

Bogus = SyntaxElement*
BogusDecl = SyntaxElement*
BogusExpr = SyntaxElement*
BogusParameter = SyntaxElement*
BogusPat = SyntaxElement*
BogusType = SyntaxElement*

Name = value: 'ident'

Path =
    qualifier: PathQualifier?
    segment: PathSegment

PathQualifier = Path '::'

// What one segment of a path is written as: the root the path starts at, or a name.
//
// The first segment of a path is its root, and only it: `project::data` is a path of the name
// `data` inside the project the module is written in, while a keyword written after a `::` is
// not a root. The grammar holds one shape for every segment; the parser is what reads a
// keyword where the root belongs, and what reports one written elsewhere while keeping it the
// segment of the path it is, so that the path around the mistake is read whole.
PathSegment =
    root: PathRoot
    TypeArgs?

PathRoot =
    Name
    | Project

// The project the module that wrote the path is written in.
//
// A module is of a project without naming it: what a manifest calls the project is a name no
// source depends on, which is what makes this keyword steadier than the name itself.
Project = 'project'

TypeArgs = '[' TypeArgList ']'

TypeArgList = (Type (',' Type)* ','?)

//*************************//
//          Items          //
//*************************//

ModuleRoot =
    bom: 'UNICODE_BOM'?
    preamble: ModulePreamble?
    items: ModuleItemList
    eof: 'EOF'

// The preamble of a module: what the module says about itself as a whole, and the path it
// declares itself as. The attributes are the ones the language has for a module rather than
// for a declaration of one, and `#[no-prelude]` is the one there is today.
ModulePreamble =
    attributes: AttributeList
    'module' name: Path

ModuleItemList = ModuleItem*

ModuleItem =
    FunDecl
    | TypeDecl
    | UseDecl
    | BogusDecl

AttributeList = Attribute*

// An attribute of a declaration: `#[extern]`.
//
// The brackets are what a list of types is written with as well, and the two are told apart
// by the `#` and by the place: an attribute list stands in front of a declaration, and a list
// of types follows a name.
Attribute =
    '#'
    '['
    name: Name
    ']'

TypeDecl =
    attributes: AttributeList
    visibility: 'pub'?
    'type'
    name: Name

FunDecl =
    attributes: AttributeList
    visibility: 'pub'?
    'fun'
    name: Name
    parameters: Parameters
    return_type_annotation: FunReturnTypeAnnotation?
    body: FunBody?

FunReturnTypeAnnotation =
    ':'
    return_type: Type

FunBody =
    '='
    expr: Expr

Parameters =
    '('
    items: ParameterList
    ')'

// A parameter of a function declaration, or the tokens of one that is broken:
// the list keeps the tokens of a mistake inside itself instead of breaking the
// declaration they were written in.
AnyParameter =
    Parameter
    | BogusParameter

ParameterList = (AnyParameter (',' AnyParameter)*)

Parameter =
    pat: Pat
    type_annotation: TypeAnnotation?

TypeAnnotation =
    ':'
    type: Type

//****************************//
//           Imports          //
//****************************//

// An import: a name the module takes from another path of the project. The name it brings in
// is the last segment of the path, or the name it is renamed to.
//
// An import carries no attributes: what an import is, is what it brings in and how far it is
// visible.
UseDecl =
    visibility: 'pub'?
    'use'
    path: Path
    alias: UseAlias?

UseAlias =
    'as'
    name: Name

//****************************//
//        Expressions         //
//****************************//

Expr =
    Literal
    | PathExpr
    | CallExpr
    | UfcsCall
    | FieldExpr
    | UnaryExpr
    | BinExpr
    | PipeExpr
    | PlaceholderExpr
    | IfExpr
    | LetExpr
    | LambdaExpr
    | ParenExpr
    | BogusExpr

IntLiteral = value: 'int_literal'
StringLiteral = value: 'string_literal'

// A truth value: `true` or `false`. Both are keywords of the language, and the token the
// literal holds is the one it is written with.
BoolLiteral = value: ('true' | 'false')

Literal =
    IntLiteral
    | StringLiteral
    | BoolLiteral

// A path written where a value belongs: a name the body binds, a name the module declares,
// or a path that starts with a name of the project.
PathExpr = path: Path

// A sign in front of an expression: `-1`, `+x`, `-f(1)`. It binds tighter than a binary
// operator and looser than a call, so `-f(1) + 2` is `(-f(1)) + 2`.
UnaryExpr =
    operator_token: ('-' | '+')
    operand: Expr

CallExpr =
    function: Expr
    '('
    arguments: ArgumentList
    ')'

// A call with the value written before the name it calls: `value.function(args)`.
//
// The receiver is passed as the first argument of the call the spelling means:
// `value.function(a)` is `function(value, a)`. What stands after the dot is the callee the
// call means, which is a name or a path, and the call is written after it, so a dot is never
// a way to name a function with its first argument left open.
UfcsCall =
    receiver: Expr
    '.'
    callee: Path
    '('
    arguments: ArgumentList
    ')'

// A field read: the value, and the name of the field: `data@field`.
FieldExpr =
    receiver: Expr
    '@'
    field: Name

ArgumentList = (Expr (',' Expr)* ','?)

// A pipeline: a value, and the call it goes into: `x |> f(a, _)`.
//
// What the pipeline means is `let v = x in f(a, v)`: the value is bound before the call,
// and every `_` among the arguments of the call is the binding. The value is bound first
// whatever the call writes, so the left side is what runs first, and the chain reads in
// one direction.
//
// The step is a call, and it is one call: the callee is a name, a path, or a receiver
// written with the dot, whose receiver is a name or a path as well. A step ends with the
// argument list of its call: a dot, a `|>`, or a binary operator written after it is
// written after the value the pipeline is.
PipeExpr =
    lhs: Expr
    '|>'
    step: Expr

// A place for the value a pipeline passes: `x |> f(_)`.
//
// A place is a leaf of the expression grammar, and it is read only among the arguments of
// the call the step of a pipeline is: anywhere else a `_` is not a value.
PlaceholderExpr = '_'

BinExpr =
    lhs: Expr
    operator_token: ('+' | '-' | '*' | '/' | '==' | '!=' | '<' | '<=' | '>' | '>=' | '&&' | '||')
    rhs: Expr

LetExpr =
    'let'
    pat: Pat
    '='
    expr: Expr
    'in'
    body: Expr

// A lambda: a function written where a value belongs: `fn(a, b) -> expr`.
//
// The parameters are the parameters of a function declaration: patterns, and the types they
// take where the module writes them. They bind the body the way the parameters of a function
// declaration bind the body of it. The body is an expression, and it extends as far as it can:
// what is written after the body is written after the value the lambda is.
LambdaExpr =
    'fn'
    '('
    parameters: LambdaParameterList
    ')'
    '->'
    body: Expr

LambdaParameterList = (AnyParameter (',' AnyParameter)*)

// A choice between expressions: a condition, the expression it selects, the `elif` arms
// written after it, and the expression selected when no condition holds.
//
// Every condition is a `Bool`, the arms are read in the order they are written, and the
// expression is one value: the arms are expressions of one type. The `else` may be left
// unwritten, and an `if` without one selects no value: its arms are `Unit`, and so it is.
IfExpr =
    'if'
    condition: Expr
    'then'
    then_branch: Expr
    arms: IfArmList
    else_branch: ElseBranch?

ElseBranch =
    'else'
    expr: Expr

IfArmList = IfArm*

// One `elif` arm of an `if`: its own condition and the expression it selects.
IfArm =
    'elif'
    condition: Expr
    'then'
    body: Expr

ParenExpr =
    '('
    expr: Expr
    ')'

//****************************//
//           Types            //
//****************************//

Type =
    PathType
    | InferType
    | BogusType

PathType = Path

InferType = '_'

//************************//
//        Patterns        //
//************************//

Pat =
    IdentPat
    | WildcardPat
    | BogusPat

IdentPat = Name

WildcardPat = '_'
