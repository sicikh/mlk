// MLK Un-Grammar.
//
// This grammar specifies the structure of MLK's concrete syntax tree.
// It does not specify parsing rules (ambiguities, precedence, etc are out of scope).
// Tokens are processed -- contextual keywords are recognised, compound operators glued.
//
// Legend:
//
//   //          				-- comment
//   Name =      				-- non-terminal definition
//   'ident'     				-- token (terminal)
//   A B         				-- sequence
//   A | B       				-- alternation
//   A*          				-- zero or more repetition
//   (A (',' A)* ','?)	        -- repetition of node A separated by ',' and allowing a trailing comma
//   (A (',' A)*)	            -- repetition of node A separated by ',' without a trailing comma
//   A?          				-- zero or one repetition
//   (A)         				-- same as A
//   label:A     				-- suggested name for field of AST node

// NOTES
//
// - SyntaxNode, SyntaxToken and SyntaxElement will be stripped from the codegen
// - Bogus nodes are special nodes used to keep track of broken code; they are
//   not part of the grammar but they will appear inside the green tree


///////////////
// Bogus NODES
///////////////
// SyntaxElement is a generic data structure that is meant to track nodes and tokens
// in cases where we care about both types
//
// As Bogus* node will need to yield both tokens and nodes without discrimination,
// and their children will need to yield nodes and tokens as well.
// For this reason, SyntaxElement = SyntaxElement
SyntaxElement = SyntaxElement

Bogus = SyntaxElement*
BogusDecl = SyntaxElement*
BogusExpr = SyntaxElement*
BogusParameter = SyntaxElement*
BogusPat = SyntaxElement*
BogusType = SyntaxElement*

Name = value: 'ident'

Path =
    qualifier: PathQualifier?
    segment: PathSegment

PathQualifier = Path '.'

PathSegment = Name TypeArgs?

TypeArgs = '[' TypeArgList ']'

TypeArgList = (Type (',' Type)* ','?)

//*************************//
//          Items          //
//*************************//

ModuleRoot =
    bom: 'UNICODE_BOM'?
    preamble: ModulePreamble?
    items: ModuleItemList
    eof: 'EOF'

ModulePreamble =
    'module' name: Path

ModuleItemList = ModuleItem*

ModuleItem =
    FunDecl
    | TypeDecl
    | UseDecl
    | BogusDecl

AttributeList = Attribute*

Attribute =
    '@'
    name: Name

TypeDecl =
    attributes: AttributeList
    visibility: 'pub'?
    'type'
    name: Name

FunDecl =
    attributes: AttributeList
    visibility: 'pub'?
    'fun'
    name: Name
    parameters: Parameters
    return_type_annotation: FunReturnTypeAnnotation?
    body: FunBody?

FunReturnTypeAnnotation =
    ':'
    return_type: Type

FunBody =
    '='
    expr: Expr

Parameters =
    '('
    items: ParameterList
    ')'

// A parameter of a function declaration, or the tokens of one that is broken:
// the list keeps the tokens of a mistake inside itself instead of breaking the
// declaration they were written in.
AnyParameter =
    Parameter
    | BogusParameter

ParameterList = (AnyParameter (',' AnyParameter)*)

Parameter =
    pat: Pat
    type_annotation: TypeAnnotation?

TypeAnnotation =
    ':'
    type: Type

//****************************//
//           Imports          //
//****************************//

// An import: a name the module takes from another path of the project. The name it brings in
// is the last segment of the path, or the name it is renamed to.
//
// An import carries no attributes: what an import is, is what it brings in and how far it is
// visible.
UseDecl =
    visibility: 'pub'?
    'use'
    path: Path
    alias: UseAlias?

UseAlias =
    'as'
    name: Name

//****************************//
//        Expressions         //
//****************************//

Expr =
    Literal
    | PathExpr
    | CallExpr
    | UnaryExpr
    | BinExpr
    | LetExpr
    | ParenExpr
    | BogusExpr

IntLiteral = value: 'int_literal'
StringLiteral = value: 'string_literal'

Literal =
    IntLiteral
    | StringLiteral

// A path written where a value belongs: a name the body binds, a name the module declares,
// or a path that starts with a name of the project.
PathExpr = path: Path

// A sign in front of an expression: `-1`, `+x`, `-f(1)`. It binds tighter than a binary
// operator and looser than a call, so `-f(1) + 2` is `(-f(1)) + 2`.
UnaryExpr =
    operator_token: ('-' | '+')
    operand: Expr

CallExpr =
    function: Expr
    '('
    arguments: ArgumentList
    ')'

ArgumentList = (Expr (',' Expr)* ','?)

BinExpr =
    lhs: Expr
    operator_token: ('+' | '-' | '*' | '/' | '==' | '!=' | '<' | '<=' | '>' | '>=' | '&&' | '||')
    rhs: Expr

LetExpr =
    'let'
    pat: Pat
    '='
    expr: Expr
    'in'
    body: Expr

ParenExpr =
    '('
    expr: Expr
    ')'

//****************************//
//           Types            //
//****************************//

Type =
    PathType
    | InferType
    | BogusType

PathType = Path

InferType = '_'

//************************//
//        Patterns        //
//************************//

Pat =
    IdentPat
    | WildcardPat
    | BogusPat

IdentPat = Name

WildcardPat = '_'
