// MLK Un-Grammar.
//
// This grammar specifies the structure of MLK's concrete syntax tree.
// It does not specify parsing rules (ambiguities, precedence, etc are out of scope).
// Tokens are processed -- contextual keywords are recognised, compound operators glued.
//
// Legend:
//
//   //          				-- comment
//   Name =      				-- non-terminal definition
//   'ident'     				-- token (terminal)
//   A B         				-- sequence
//   A | B       				-- alternation
//   A*          				-- zero or more repetition
//   (A (',' A)* ','?)	        -- repetition of node A separated by ',' and allowing a trailing comma
//   (A (',' A)*)	            -- repetition of node A separated by ',' without a trailing comma
//   A?          				-- zero or one repetition
//   (A)         				-- same as A
//   label:A     				-- suggested name for field of AST node

// NOTES
//
// - SyntaxNode, SyntaxToken and SyntaxElement will be stripped from the codegen
// - Bogus nodes are special nodes used to keep track of broken code; they are
//   not part of the grammar but they will appear inside the green tree


///////////////
// Bogus NODES
///////////////
// SyntaxElement is a generic data structure that is meant to track nodes and tokens
// in cases where we care about both types
//
// As Bogus* node will need to yield both tokens and nodes without discrimination,
// and their children will need to yield nodes and tokens as well.
// For this reason, SyntaxElement = SyntaxElement
SyntaxElement = SyntaxElement

Bogus = SyntaxElement*
BogusDecl = SyntaxElement*
BogusExpr = SyntaxElement*
BogusPat = SyntaxElement*
BogusType = SyntaxElement*

Name = value: 'ident'

Path =
    (qualifier: Path '.')?
    segment: PathSegment

PathSegment = Name TypeArgs?

TypeArgs = '[' TypeArgList ']'

TypeArgList = (Type (',' Type)* ','?)

//*************************//
//          Items          //
//*************************//

ModuleRoot =
    items: ModuleItemList
    eof: 'EOF'

ModulePreamble =
    'module' name: Path

ModuleItemList = ModuleItem*

ModuleItem =
    FunDecl
    | TypeDecl
    | BogusDecl

AttributeList = Attribute*

Attribute =
    '@'
    name: Name

TypeDecl =
    attributes: AttributeList
    'type'
    name: Name

FunDecl =
    attributes: AttributeList
    'fun'
    name: Name
    parameters: Parameters
    return_type_annotation: FunReturnTypeAnnotation?
    body: FunBody?

FunReturnTypeAnnotation =
    ':'
    return_type: Type

FunBody =
    '='
    expr: Expr

Parameters =
    '('
    items: ParameterList
    ')'

ParameterList = (Parameter (',' Parameter)*)

Parameter =
    name: Name
    type_annotation: TypeAnnotation?

TypeAnnotation =
    ':'
    type: Type

//****************************//
//        Expressions         //
//****************************//

Expr =
    Literal
    | VarExpr
    | CallExpr
    | BinExpr
    | LetExpr
    | ParenExpr
    | BogusExpr

IntLiteral = value: 'int_literal'
StringLiteral = value: 'string_literal'

Literal =
    IntLiteral
    | StringLiteral

VarExpr = name: Name

CallExpr =
    function: Expr
    '('
    arguments: ArgumentList
    ')'

ArgumentList = (Expr (',' Expr)* ','?)

BinExpr =
    lhs: Expr
    operator_token: ('+' | '-' | '*' | '/' | '==' | '!=' | '<' | '<=' | '>' | '>=')
    rhs: Expr

LetExpr =
    'let'
    pat: Pat
    '='
    expr: Expr
    'in'
    body: Expr

// `(42 * 2 - 10)`
ParenExpr =
    '('
    expr: Expr
    ')'

//****************************//
//           Types            //
//****************************//

Type =
    PathType
    | BogusType

PathType = Path

InferType = '_'

//************************//
//        Patterns        //
//************************//

Pat =
    IdentPat
    | WildcardPat
    | BogusPat

IdentPat = Name

WildcardPat = '_'
